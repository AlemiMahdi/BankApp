@page
@model BankApp.Web.Pages.Customers.DetailsModel
@{
    ViewData["Title"] = "Kundbild";
}

<div class="page-header d-print-none">
    <h2 class="page-title">Kundbild</h2>
</div>

@if (Model.Customer == null)
{
    <div class="alert alert-warning mt-3">
        Ingen kund med kundnummer @Model.Id hittades.
    </div>
    <a asp-page="./Index" class="btn btn-primary">Tillbaka till kunder</a>
}
else
{
    var c = Model.Customer;

    <div class="card mt-3">
        <div class="card-header">
            <h3 class="card-title">@c.Givenname @c.Surname</h3>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Kundnummer</dt>
                <dd class="col-sm-9">@c.CustomerId</dd>

                <dt class="col-sm-3">Personnummer</dt>
                <dd class="col-sm-9">@c.NationalId</dd>

                <dt class="col-sm-3">Födelsedatum</dt>
                <dd class="col-sm-9">@c.Birthday?.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-3">Kön</dt>
                <dd class="col-sm-9">@c.Gender</dd>

                <dt class="col-sm-3">Adress</dt>
                <dd class="col-sm-9">@c.Streetaddress, @c.Zipcode @c.City</dd>

                <dt class="col-sm-3">Land</dt>
                <dd class="col-sm-9">@c.Country (@c.CountryCode)</dd>

                <dt class="col-sm-3">Telefon</dt>
                <dd class="col-sm-9">@c.Telephonecountrycode @c.Telephonenumber</dd>

                <dt class="col-sm-3">E-post</dt>
                <dd class="col-sm-9">@c.Emailaddress</dd>
            </dl>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header">
            <h3 class="card-title">Konton</h3>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>Kontonummer</th>
                        <th>Typ</th>
                        <th>Skapat</th>
                        <th class="text-end">Saldo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (c.Accounts.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center text-secondary">Kunden har inga konton.</td>
                        </tr>
                    }
                    @foreach (var account in c.Accounts)
                    {
                        <tr>
                            <td>@account.AccountId</td>
                            <td>@account.Type</td>
                            <td>@account.Created.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">@account.Balance.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="3">Totalt saldo</th>
                        <th class="text-end">@c.TotalBalance.ToString("N2")</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="./Index" class="btn btn-outline-primary">Tillbaka till kunder</a>
    </div>
}