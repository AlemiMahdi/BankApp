@page
@model IndexModel
@{
    ViewData["Title"] = "Startsida";
}

<div class="page-header d-print-none">
    <h2 class="page-title">Statistik per land</h2>
</div>

<div class="card mt-3">
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th>Land</th>
                    <th class="text-end">Antal kunder</th>
                    <th class="text-end">Antal konton</th>
                    <th class="text-end">Totalt saldo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var country in Model.Countries)
                {
                    <tr>
                        <td>@country.Country</td>
                        <td class="text-end">@country.CustomerCount.ToString("N0")</td>
                        <td class="text-end">@country.AccountCount.ToString("N0")</td>
                        <td class="text-end">@country.TotalBalance.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>